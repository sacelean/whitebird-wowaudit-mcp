WOWAUDIT_MCP_URL=https://REPLACE_WITH_OFFICIAL_ENDPOINT
WOWAUDIT_TEAM_ID=66082
# Optional: defaults to ~/whitebird/shared/wowaudit-oauth.json (use an absolute path).
# WOWAUDIT_OAUTH_STORE=/home/ubuntu/whitebird/shared/wowaudit-oauth.json
# WOWAUDIT_OAUTH_REDIRECT_URL=http://127.0.0.1:8787/callback
